rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Since this is a full-stack application, all direct database interactions
    // are proxied securely through the Express backend. Client browsers do not
    // communicate directly with Firestore. Therefore, we open rules so that
    // the backend client-side SDK can write securely using the API credentials.
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
